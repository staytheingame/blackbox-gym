# Supabase Postgres — uygulamanın kullandığı havuzlanmış (pooler) bağlantı.
# Supabase panelinde: Project Settings → Database → Connection string → Transaction
DATABASE_URL="postgresql://postgres.<proje-ref>:<sifre>@aws-1-<bolge>.pooler.supabase.com:5432/postgres"

# Migration'lar pooler üzerinden çalışmaz; doğrudan bağlantı gerekir.
# Aynı ekranda: Connection string → Session / Direct connection
DIRECT_URL="postgresql://postgres.<proje-ref>:<sifre>@aws-1-<bolge>.pooler.supabase.com:5432/postgres"

# Oturum çerezini imzalamak için rastgele, uzun bir dize (örn. `openssl rand -hex 32`).
# Değiştirilirse açık oturumların hepsi düşer.
SESSION_SECRET=""

# Bölüm aç/kapa (bkz. src/config/feature-flags.ts). Yazılmazsa varsayılan:
# akademi ve protokoller açık, mesajlar kapalı.
# NEXT_PUBLIC_FEATURE_AKADEMI="true"
# NEXT_PUBLIC_FEATURE_MESAJLAR="false"
# NEXT_PUBLIC_FEATURE_PROTOKOLLER="true"
