# Supabase Postgres — uygulamanın kullandığı havuzlanmış (pooler) bağlantı.
# Supabase panelinde: Project Settings → Database → Connection string → Transaction
DATABASE_URL="postgresql://postgres.<proje-ref>:<sifre>@aws-1-<bolge>.pooler.supabase.com:5432/postgres"

# Migration'lar pooler üzerinden çalışmaz; doğrudan bağlantı gerekir.
# Aynı ekranda: Connection string → Session / Direct connection
DIRECT_URL="postgresql://postgres.<proje-ref>:<sifre>@aws-1-<bolge>.pooler.supabase.com:5432/postgres"

# Oturum çerezini imzalamak için rastgele, uzun bir dize (örn. `openssl rand -hex 32`).
# Değiştirilirse açık oturumların hepsi düşer.
SESSION_SECRET=""

# Bölüm aç/kapa (bkz. src/config/feature-flags.ts). Yazılmazsa hepsi açık.
# Kuşak merdiveni yalnız derece veren salonlar için anlamlıdır; onam
# formları hukuki gereklilik olduğu için varsayılan açıktır.
# NEXT_PUBLIC_FEATURE_MESAJLAR="false"
# NEXT_PUBLIC_FEATURE_PROTOKOLLER="true"
# NEXT_PUBLIC_FEATURE_KUSAKLAR="true"
# NEXT_PUBLIC_FEATURE_ONAYLAR="true"

# ── Davet bağlantısı ──────────────────────────────────────────
# Antrenörün sporcuya göndereceği `/davet/<token>` adresinin kök alanı.
# Yazılmazsa Vercel'in üretim alan adı kullanılır; yerelde bunu doldur.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ── Zamanlanmış hatırlatma ────────────────────────────────────
# `/api/cron/hatirlatici` ucunu korur. Vercel Cron `Authorization: Bearer
# <secret>` başlığını kendiliğinden gönderir. BOŞ BIRAKILIRSA UÇ AÇIK KALIR —
# üretimde mutlaka doldur (`openssl rand -hex 32`).
CRON_SECRET=""

# ── Bildirim kanalları (opsiyonel) ────────────────────────────
# Uygulama içi bildirim kutusu HER ZAMAN çalışır; aşağıdakiler tanımlıysa
# bildirim ayrıca e-posta/WhatsApp ile de gider.
#
# E-POSTA — ücretsiz katmanlarla çalışır, ek npm paketi gerekmez.
# İkisinden birini doldurmak yeterli (ikisi de varsa Brevo kullanılır):
#   Brevo  → günde 300 e-posta, süresiz ücretsiz, kredi kartı istemez
#   Resend → ayda 3.000 / günde 100 ücretsiz
# Gönderen adresi ZORUNLU: sağlayıcıda doğrulanmış bir adres olmalı.
# NOTIFY_FROM_EMAIL="bildirim@salonunalanadi.com"
# NOTIFY_FROM_NAME="BlackBox"
# BREVO_API_KEY=""
# RESEND_API_KEY=""
#
# WHATSAPP — Meta/Twilio tarafında konuşma başına ÜCRETLİDİR, ücretsiz değil.
# Bağlanacaksa sağlayıcının mesaj gönderme uç noktası ve jetonu:
# WHATSAPP_API_URL="https://graph.facebook.com/v21.0/<telefon-id>/messages"
# WHATSAPP_API_TOKEN=""
